# Copy to .env (git-ignored) and fill in. Used only by `yarn test:e2e` and scripts/record-fixtures.mjs.
# Everything runs against the Namecheap SANDBOX, never production.

# Credentials of a sandbox account (sandbox.namecheap.com), with API access enabled
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
# Public IP of this machine, added to the API whitelist of that account
NAMECHEAP_CLIENT_IP=

# Throw-away account used by the password tests (login/changePassword). Never use your main account.
# Username: letters and digits only. Password: strong, e.g. upper + lower + digit + symbol.
NAMECHEAP_E2E_USER=
NAMECHEAP_E2E_PASS=
