{
  "name": "@fwgapps/namecheap",
  "type": "module",
  "version": "2.0.1",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && tsup",
    "test": "vitest",
    "test:e2e": "node --env-file=.env node_modules/vitest/vitest.mjs run --no-file-parallelism tests/e2e",
    "coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' 'scripts/**/*.{mjs,mts,ts}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' 'scripts/**/*.{mjs,mts,ts}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' 'scripts/**/*.{mjs,mts,ts}'",
    "prepublishOnly": "yarn build",
    "prepare": "husky",
    "commit": "cz",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "namecheap",
    "namecheap-api",
    "namecheap-sdk",
    "namecheap-client",
    "namecheap-xml-api",
    "domain",
    "domains",
    "domain-registrar",
    "domain-registration",
    "domain-availability",
    "dns",
    "dns-management",
    "nameserver",
    "ssl",
    "ssl-certificates",
    "whoisguard",
    "whois",
    "registrar",
    "api-client",
    "sdk",
    "typescript",
    "esm",
    "cjs",
    "tree-shakeable",
    "zero-dependency",
    "nodejs",
    "cloudflare-workers",
    "deno",
    "bun"
  ],
  "author": "Anderson Fernandes",
  "license": "ISC",
  "description": "Typed, zero-dependency TypeScript client for the Namecheap XML API: domains, DNS, nameservers, SSL, transfers and WhoisGuard. ESM + CJS, tree-shakeable, works on Node 22+ and edge runtimes.",
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript-eslint/utils": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "semantic-release": "^25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fwgapps/namecheap.git"
  },
  "homepage": "https://fwgapps.github.io/namecheap/",
  "bugs": {
    "url": "https://github.com/fwgapps/namecheap/issues"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "resolutions": {
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.5",
    "**/@npmcli/arborist/minimatch": "^11.0.5",
    "**/@npmcli/map-workspaces/minimatch": "^11.0.5",
    "**/@tufjs/models/minimatch": "^11.0.5",
    "**/ignore-walk/minimatch": "^11.0.5",
    "**/libnpmdiff/minimatch": "^11.0.5",
    "**/npm/minimatch": "^11.0.5",
    "**/@npmcli/map-workspaces/glob/minimatch": "^11.0.5",
    "**/@npmcli/package-json/glob/minimatch": "^11.0.5",
    "**/cacache/glob/minimatch": "^11.0.5",
    "**/npm/glob/minimatch": "^11.0.5",
    "**/eslint/minimatch": "^11.0.5",
    "**/@eslint/config-array/minimatch": "^11.0.5",
    "**/commitizen/glob/minimatch": "^11.0.5"
  }
}
